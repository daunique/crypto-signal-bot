APP_NAME=deriv-higher-lower-bot
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8080
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# PAT authentication
DERIV_APP_ID=
DERIV_PAT=
# Optional account override. Otherwise selected automatically from BOT_MODE.
DERIV_ACCOUNT_ID=
# Must be "demo" or "live" (case/whitespace-insensitive). This is only the
# fallback default for a brand-new deployment -- once the Demo/Live toggle
# on the Settings page has been used, its saved value takes over and
# persists across restarts (see README).
BOT_MODE=demo

MARKET_SYMBOL=R_25
TIMEFRAME_SECONDS=180
STAKE=1.0
CURRENCY=USD
MIN_CONFLUENCE_SCORE=6
AUTO_TRADE=true
REQUEST_TIMEOUT_SECONDS=15
# Higher/Lower barrier distance, as a fraction of the recent average candle
# range (ATR). Larger = harder to win but bigger payout; smaller = odds
# closer to Rise/Fall. Must be > 0.
BARRIER_ATR_FRACTION=0.25
# If true, flips which side is *recorded and displayed* as the strategy's
# predicted direction. Does NOT change what gets traded: every qualifying
# signal opens BOTH a HIGHER and a LOWER position regardless of this
# setting (see README's execute_straddle note).
INVERT_SIGNALS=false
