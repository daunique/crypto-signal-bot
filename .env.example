# Copy this file to ".env" in the same folder and fill in your own values.
# NEVER commit or share the real .env file — it contains your private key.

# --- Required: your Polymarket wallet ---
# The private key for whatever signs your orders. If you signed up with
# email/Google (Magic-link wallet) rather than connecting MetaMask directly,
# this is the key exported from Polymarket Settings — see POLY_SIGNATURE_TYPE.
POLY_PRIVATE_KEY=

# Your Polymarket proxy wallet address, shown on the Settings page — this is
# where your funds actually sit. Required whenever POLY_SIGNATURE_TYPE != 0
# (which includes the default of 1 below).
POLY_FUNDER_ADDRESS=

# 0 = plain EOA (you hold the private key directly and it IS the funding address)
# 1 = email/Magic-link wallet (default here) — private key signs, funds sit at
#     the separate POLY_FUNDER_ADDRESS proxy
# 2 = browser extension wallet proxy (MetaMask connected via Polymarket UI)
# Deposit wallets (type 3 / POLY_1271) use a different, more involved relayer
# setup — see README.md, not supported by this script directly.
POLY_SIGNATURE_TYPE=1

# --- Strategy parameters (defaults match what we backtested) ---
K1_SECONDS=60
K2_SECONDS=90
TOL_SECONDS=5
ASSETS=BTC,ETH,SOL,XRP,BNB,DOGE,HYPE
DURATIONS_MIN=5

# --- Money / risk controls ---
# NOTE: read the big warning in momentum_bot.py and README.md about the
# exchange's ~5-share minimum order size before assuming $0.20 will actually
# place trades. Most $0.20 attempts will be SKIPPED, not executed.
STAKE_USD=0.20
FALLBACK_MIN_SHARES=5
MAX_TRADES_PER_DAY=20
MAX_DAILY_LOSS_USD=5.00

# Docs describe the 5-share minimum as applying to all order types, but that's
# not confirmed for FOK/FAK specifically (a rejection costs nothing but an API
# call, so this is safe to test). true (default) = never submit below-minimum
# trades. false = submit anyway on --live and log the exchange's real answer
# (search the trade log for MIN_SIZE_TEST).
SKIP_BELOW_MIN_SIZE=true

# --- Where logs/state get stored on your phone (Fly.io: leave as /data, set via fly.toml instead) ---
BOT_STATE_DIR=~/.polymarket_bot

# --- Only relevant for --live with no terminal attached (e.g. Fly.io) ---
# input() can't prompt you inside a headless container, so this exact phrase
# is required as a stand-in confirmation instead. Leave unset for Termux —
# you'll get the interactive typed prompt there instead.
CONFIRM_LIVE_TRADING=
