APP_NAME=deriv-higher-lower-bot
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8080
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# PAT authentication
DERIV_APP_ID=
DERIV_PAT=
# Optional account override. Otherwise selected automatically from BOT_MODE.
DERIV_ACCOUNT_ID=
# Must be "demo" or "live" (case/whitespace-insensitive). This is only the
# fallback default for a brand-new deployment -- once the Demo/Live toggle
# on the Settings page has been used, its saved value takes over and
# persists across restarts (see README).
BOT_MODE=demo

MARKET_SYMBOL=R_25
STAKE=1.0
CURRENCY=USD
AUTO_TRADE=true
REQUEST_TIMEOUT_SECONDS=15

# --- Strategy: volatility-timing (see README's "Honest performance note" --
# validated win rate at the live quoted payout is ~31.9-32.0%, short of the
# 33.33% breakeven by ~1.0-1.6 points; this is not known to be profitable) ---

# Contract duration in ticks. This is what was actually backtested --
# changing it means trading an unvalidated variant. Must be > 0.
CONTRACT_DURATION_TICKS=10
# Fixed, signed-offset barrier magnitude (NOT ATR-derived -- sign is applied
# automatically from BET_DIRECTION: +BARRIER for HIGHER, -BARRIER for LOWER).
# Must be > 0.
BARRIER=0.30
# HIGHER or LOWER. Fixed rather than computed: backtesting found no
# directional edge on this instrument either way, so this only needs to be
# *a* consistent choice, not the "right" one.
BET_DIRECTION=LOWER
# Rolling window (in ticks) for the realized-volatility estimate. Must be > 1.
VOL_WINDOW_TICKS=100
# How many preceding UTC days feed the volatility-percentile threshold
# (never including the current day). Must be > 0.
VOL_TRAILING_DAYS=90
# A signal fires when current rolling volatility is at/above this percentile
# of its trailing history (90 = "top 10% most volatile moments"). This is a
# *timing* filter only -- it has no bearing on direction. Must be in (0, 100).
VOL_TARGET_PERCENTILE=90.0

# --- Main/sub PnL-track risk-management overlay (see README) ---
# MAIN switches to SUB once MAIN's PnL (accumulated since it was last
# entered) reaches this amount. On a live account, entering SUB this way
# also auto-switches the bot to demo mode. Must be > 0.
PNL_TRACK_PROFIT_TARGET=10.0
# SUB switches back to MAIN once this many consecutive losses happen on SUB.
# If the account was auto-switched to demo when it entered SUB, this also
# switches it back to live. Must be > 0.
PNL_TRACK_LOSS_STREAK_LIMIT=5
