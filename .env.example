APP_NAME=deriv-higher-lower-bot
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8080
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# PAT authentication
DERIV_APP_ID=
DERIV_PAT=
# Optional account override. Otherwise selected automatically from BOT_MODE.
DERIV_ACCOUNT_ID=
# Must be "demo" or "live" (case/whitespace-insensitive). This is only the
# fallback default for a brand-new deployment -- once the Demo/Live toggle
# on the Settings page has been used, its saved value takes over and
# persists across restarts (see README).
BOT_MODE=demo

MARKET_SYMBOL=R_25
TRADE_DURATION_TICKS=10
STAKE=1.0
CURRENCY=USD
AUTO_TRADE=true
REQUEST_TIMEOUT_SECONDS=15
# Higher/Lower barrier distance: a literal fixed offset from spot (not
# scaled by volatility). Must be > 0.
# KNOWN ECONOMICS: backtesting 0.25 at 10-tick duration on R_25 found a win
# rate of roughly 32-34%, which is BELOW the ~38.46% breakeven implied by a
# $2.60-back-on-$1-stake payout. See README/config.py before trading this
# live with real funds.
BARRIER_FIXED_OFFSET=0.25
TICK_VOL_WINDOW=20
