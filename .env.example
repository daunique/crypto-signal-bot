APP_NAME=deriv-higher-lower-bot
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8080
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# PAT authentication
DERIV_APP_ID=
DERIV_PAT=
# Optional account override. Otherwise selected automatically from BOT_MODE.
DERIV_ACCOUNT_ID=
# Must be "demo" or "live" (case/whitespace-insensitive). This is only the
# fallback default for a brand-new deployment -- once the Demo/Live toggle
# on the Settings page has been used, its saved value takes over and
# persists across restarts (see README).
BOT_MODE=demo

MARKET_SYMBOL=R_25
TRADE_DURATION_TICKS=10
STAKE=1.0
CURRENCY=USD
AUTO_TRADE=true
REQUEST_TIMEOUT_SECONDS=15
# Higher/Lower barrier distance, as a fraction of rolling tick volatility
# (stdev of the last TICK_VOL_WINDOW tick-to-tick price changes). Larger =
# harder to win but bigger payout; smaller = odds closer to Rise/Fall.
# Must be > 0. 0.25 is the value the shipped strategy was backtested at.
BARRIER_VOL_FRACTION=0.25
TICK_VOL_WINDOW=20
