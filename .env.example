# ═══════════════════════════════════════════════════════════════════════
# SignalBot — Environment Variables
# Copy this file to .env locally, or paste into Render → Environment.
# NEVER commit .env to GitHub — add it to .gitignore.
# ═══════════════════════════════════════════════════════════════════════

# ── Flask ──────────────────────────────────────────────────────────────
SECRET_KEY=change_this_to_any_random_32char_string
FLASK_ENV=production

# ── Database ───────────────────────────────────────────────────────────
# SQLite (works on Render free tier, resets on redeploy)
DATABASE_URL=sqlite:////tmp/signals.db
# PostgreSQL (recommended — persists across deploys):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ══════════════════════════════════════════════════════════════════════
# LIMITLESS EXCHANGE — required for live trading
# ══════════════════════════════════════════════════════════════════════
#
# STEP 1 of 2 — Get your HMAC API token (60 seconds, one-time):
#
#   a. Go to limitless.exchange and connect your wallet.
#   b. Open DevTools (F12) → Console → paste this and press Enter:
#
#        const tok = localStorage.getItem('privy:token');
#        fetch('https://api.limitless.exchange/auth/api-tokens/derive', {
#          method: 'POST',
#          headers: {
#            'Content-Type':  'application/json',
#            'Authorization': 'Bearer ' + tok
#          },
#          body: JSON.stringify({ label: 'btcbot', scopes: ['trading'] })
#        }).then(r => r.json()).then(d => {
#          console.log('TOKEN_ID:', d.tokenId);
#          console.log('SECRET:',   d.secret);   // ← SAVE THIS NOW (shown once)
#        });
#
#   c. Copy TOKEN_ID and SECRET into the vars below.
#      The SECRET is only shown once — if lost, derive a new token.
#
LIMITLESS_TOKEN_ID=your_token_id_here
LIMITLESS_TOKEN_SECRET=your_base64_secret_here

# Legacy key (only if you have an old lmts_... key — no new keys are issued):
# LIMITLESS_API_KEY=lmts_your_old_key_here

# STEP 2 of 2 — Wallet private key (for EIP-712 order signing):
#
#   This MUST be the private key of the wallet you connected to limitless.exchange.
#   The bot signs every order locally with this key — no transaction is sent to chain,
#   only the signed order message is submitted to the Limitless API.
#
#   To export from MetaMask: Account → three dots → Account details → Export private key
#   NEVER share this. Store ONLY in Render → Environment, never in code or git.
#
LIMITLESS_PRIVATE_KEY=0xyour_wallet_private_key_here

# SMART WALLET — your Limitless account address (shown in the UI top-left)
# This is the maker in orders (holds USDC). Your EOA signs on its behalf.
# Example: 0xefFA501072810d9CE08D5D299bf086Abd6D61b73
LIMITLESS_SMART_WALLET=0xyour_smart_wallet_address_here

# USDC Approval (one-time, after deploying):
#
#   Before live BUY orders work you must approve USDC → venue.exchange on Base.
#   The easiest way: visit limitless.exchange with your wallet and place one
#   manual trade — the UI triggers the approval automatically.
#   Alternatively: check GET /api/approval-status after deploying for instructions.
#   Once approved it stays approved forever (unless Limitless rotates the contract).

# Optional — Base RPC for on-chain approval checks (defaults to public endpoint):
# BASE_RPC_URL=https://mainnet.base.org

# ── Telegram (optional — signal + result notifications) ────────────────
# Get bot token from @BotFather, get your chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── App defaults ───────────────────────────────────────────────────────
# Start in shadow mode. Switch to "live" in the dashboard or here once
# you have confirmed the approval-status check passes.
DEFAULT_MODE=shadow
DEFAULT_POSITION_SIZE=10
