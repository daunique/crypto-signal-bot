APP_NAME=deriv-higher-lower-bot
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8080
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# Current Deriv PAT authentication
DERIV_APP_ID=
DERIV_PAT=
# Optional. If empty, the bot automatically selects the account matching BOT_MODE.
DERIV_ACCOUNT_ID=
BOT_MODE=demo

MARKET_SYMBOL=R_25
TIMEFRAME_SECONDS=180
STAKE=1.0
CURRENCY=USD
# Required. No universal/default barrier is used.
# Example: MARKET_BARRIERS=R_25=YOUR_R25_VALUE,R_10=YOUR_R10_VALUE,R_100=YOUR_R100_VALUE
MARKET_BARRIERS=
MIN_CONFLUENCE_SCORE=6
AUTO_TRADE=true
