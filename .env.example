# Current Deriv PAT authentication
DERIV_APP_ID=YOUR_PAT_APP_ID
DERIV_PAT=YOUR_FULL_PERSONAL_ACCESS_TOKEN

# Optional: pin a specific Options account ID, e.g. DOT...
# DERIV_ACCOUNT_ID=

BOT_MODE=demo
MARKET_SYMBOL=R_25
TIMEFRAME_SECONDS=180
HISTORY_COUNT=120
STAKE=1.0
CURRENCY=USD
AUTO_TRADE=true

# Required before any qualified signal can execute.
# Use the barrier value validated for each individual market.
MARKET_BARRIERS=R_25=YOUR_TESTED_R25_BARRIER,R_10=YOUR_TESTED_R10_BARRIER,R_100=YOUR_TESTED_R100_BARRIER
MIN_CONFLUENCE_SCORE=6
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db
