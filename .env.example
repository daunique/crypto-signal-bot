APP_NAME=deriv-higher-lower-bot
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8080
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# Current Deriv PAT application authentication
DERIV_APP_ID=
DERIV_PAT=
# Optional explicit account. If blank, the bot auto-selects the account matching BOT_MODE.
DERIV_ACCOUNT_ID=
BOT_MODE=demo

# Backward-compatible aliases accepted by the bot
# DERIV_API_TOKEN=
# DERIV_TOKEN=
# DERIV_DEMO_TOKEN=
# DERIV_LIVE_TOKEN=

MARKET_SYMBOL=R_25
TIMEFRAME_SECONDS=180
HISTORY_COUNT=120
STAKE=1.0
CURRENCY=USD
MARKET_BARRIERS=R_25=REPLACE_WITH_TESTED_R25_BARRIER
MIN_CONFLUENCE_SCORE=6
AUTO_TRADE=true
