# ═══════════════════════════════════════════════════════════
# SignalBot — Environment Variables
# Copy this to .env and fill in your values.
# NEVER commit .env to GitHub.
# ═══════════════════════════════════════════════════════════

# --- Flask ---
SECRET_KEY=change_this_to_any_random_32char_string
FLASK_ENV=production

# --- Database ---
# SQLite (default, works on Render free tier)
DATABASE_URL=sqlite:////tmp/signals.db
# PostgreSQL (recommended for persistence across deploys):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Limitless Exchange ---
# API key from limitless.exchange → Profile → API Keys (starts with lmts_ or sk_)
LIMITLESS_API_KEY=your_api_key_here

# Wallet private key (0x...) for EIP-712 order signing
# NEVER share this. Store ONLY in Render environment variables.
LIMITLESS_PRIVATE_KEY=0xyour_wallet_private_key_here

# --- Telegram (optional — for signal notifications) ---
# Get bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Get your chat ID from @userinfobot on Telegram
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# --- App Defaults ---
DEFAULT_MODE=shadow
DEFAULT_POSITION_SIZE=10
