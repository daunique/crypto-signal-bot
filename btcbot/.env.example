# ============================================================
# CRYPTO SIGNAL BOT - Environment Configuration
# Copy this to .env and fill in your real values
# NEVER commit .env to GitHub
# ============================================================

# --- Flask ---
SECRET_KEY=change_this_to_a_random_secret_string_32chars
FLASK_ENV=production

# --- Telegram Bot ---
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Your Telegram chat/group ID (use @userinfobot to find yours)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# --- Limitless Exchange ---
# Step 1: Derive a scoped token via POST /auth/api-tokens/derive on limitless.exchange
#         The response gives you tokenId and secret (secret shown ONCE - save it immediately)
LIMITLESS_TOKEN_ID=your_token_id_here
LIMITLESS_TOKEN_SECRET=your_base64_secret_here

# Step 2: Your wallet private key for EIP-712 order signing
#         NEVER share this. It signs the order payload itself (separate from HMAC).
LIMITLESS_PRIVATE_KEY=0xyour_private_key_here

# Step 3: Your numeric profile ID (from GET /profiles/{your_wallet_address})
LIMITLESS_OWNER_ID=0

# --- OKX (Data source, no auth needed for public data) ---
OKX_BASE_URL=https://www.okx.com

# --- Database ---
DATABASE_URL=sqlite:///signals.db

# --- App Settings ---
# Default position size in USD
DEFAULT_POSITION_SIZE=10
# Default mode: live or shadow
DEFAULT_MODE=shadow
