# Never bake secrets into the image — Fly secrets are set via
# `fly secrets set`, not via .env baked into the container.
.env

# Local data — this gets created fresh in the container and
# persisted via the Fly volume mount instead (see fly.toml).
data/trades.db
data/*.db
data/*.db-wal
data/*.db-shm
data/runtime_settings.json
data/derived_api_creds.json

# Python
__pycache__/
*.pyc
venv/
.venv/

# OS / editors
.DS_Store
*.swp

# Git
.git/
.gitignore
