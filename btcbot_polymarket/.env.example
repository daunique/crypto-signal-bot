# ═══════════════════════════════════════════════════════════════════════
# SignalBot — Polymarket Edition — Environment Variables
# Copy to .env locally, or paste into AWS Elastic Beanstalk → Configuration
# → Software → Environment properties (or use Parameter Store).
# NEVER commit .env to GitHub.
# ═══════════════════════════════════════════════════════════════════════

# ── Flask ──────────────────────────────────────────────────────────────
SECRET_KEY=change_this_to_any_random_32char_string
FLASK_ENV=production

# ── Database ───────────────────────────────────────────────────────────
# SQLite (works on AWS free tier but resets on redeploy)
DATABASE_URL=sqlite:////tmp/signals.db
# PostgreSQL via AWS RDS free tier (persists — recommended):
# DATABASE_URL=postgresql://user:password@your-rds-endpoint:5432/signalbot

# ══════════════════════════════════════════════════════════════════════
# POLYMARKET — CLOB API credentials (required for live trading)
# ══════════════════════════════════════════════════════════════════════
#
# HOW TO GET YOUR API KEY (one-time, ~2 minutes):
#
#   1. Go to https://polymarket.com and connect your wallet (Polygon mainnet).
#   2. Click your profile icon → "API Keys" → "Create new key".
#   3. Choose a passphrase and save it — you'll need it here.
#   4. Copy the API Key, Secret (shown once!), and Passphrase.
#
POLY_API_KEY=your_polymarket_api_key_here
POLY_API_SECRET=your_polymarket_api_secret_here       # shown once at creation
POLY_API_PASSPHRASE=your_chosen_passphrase_here

# Your wallet private key — used to sign on-chain USDC approvals on Polygon.
# Same wallet you connected to Polymarket.
# Export from MetaMask: Account → three dots → Account details → Export private key
# NEVER share this. Store ONLY in AWS Parameter Store or EB env vars.
POLY_PRIVATE_KEY=0xyour_wallet_private_key_here

# Polygon RPC (default works fine — use Alchemy/Infura for reliability)
POLY_RPC_URL=https://polygon-rpc.com
# POLY_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY

POLY_CHAIN_ID=137

# ══════════════════════════════════════════════════════════════════════
# POLYMARKET MARKET IDs — condition_id for each crypto pair
# ══════════════════════════════════════════════════════════════════════
#
# HOW TO FIND CONDITION IDs:
#   Option A — Dashboard search (after deploying):
#     GET /api/markets/search?q=BTC
#     Copy the condition_id from the result.
#
#   Option B — CLI:
#     python polymarket_executor.py --search "Will BTC"
#
#   Option C — Polymarket website:
#     Visit https://polymarket.com/markets, find the market,
#     the condition_id is in the URL or market details.
#
# ⚠️  Markets expire! Update these IDs when markets close.
#     Set the condition_id for each pair you want to trade.
#     Leave blank ("") to skip that pair.
#
POLY_MARKET_BTC=
POLY_MARKET_ETH=
POLY_MARKET_SOL=
POLY_MARKET_XRP=
POLY_MARKET_BNB=
POLY_MARKET_DOGE=

# Advanced: override the entire market map as JSON (optional)
# POLY_MARKET_MAP={"BTC-USDT":{"condition_id":"0xabc...","token_yes":"0x...","token_no":"0x..."}}

# ── Telegram (optional — signal + result notifications) ────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── App defaults ───────────────────────────────────────────────────────
# Start in shadow mode. Switch to "live" in the dashboard once you
# have verified approval-status passes and markets are configured.
DEFAULT_MODE=shadow
DEFAULT_POSITION_SIZE=10
